<bblocks://ogc.api.sta.Locations> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "STA Location" ;
    dct:abstract "A Location represents the spatial position of a Thing. Locations are encoded using a geometry, typically expressed in GeoJSON, and may include descriptive metadata. Locations can be associated with one or more Things and tracked historically through HistoricalLocations."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2025-10-02T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
