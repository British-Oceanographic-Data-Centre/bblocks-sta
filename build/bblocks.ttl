<https://british-oceanographic-data-centre.github.io/bblocks-sta/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Sensor Things API Building Blocks" ;
    dct:abstract """This is set of data [building blocks](https://ogcincubator.github.io/bblocks-docs/) describing reusable components of the Sensor Things API 1.1.  Building blocks provide elements that may be reused, and mappings to the underlying OMS model via the SOSA ontology. 
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """Initial work on the bblocks extraction was done for the particular cases of the Iliad project.
This initial draft can be missing some elements of the STA and relax on some formal constraints for the better support of the JSON Schema, OpenAPI 3.0.1 and JSON-LD specifications.
The mapping of schema elements to formal definitions (JSON-LD context files) shall be treated as draft proposition.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-11-06T16:40:28.155060"^^xsd:dateTime ;
    owl:imports <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.api.sta.Datastream>,
        <bblocks://ogc.api.sta.Datastream-Collection>,
        <bblocks://ogc.api.sta.Datastream.Datastream-Values-ObsCollection>,
        <bblocks://ogc.api.sta.FeatureOfInterest>,
        <bblocks://ogc.api.sta.HistoricalLocations>,
        <bblocks://ogc.api.sta.Locations>,
        <bblocks://ogc.api.sta.Observation>,
        <bblocks://ogc.api.sta.ObservedProperty>,
        <bblocks://ogc.api.sta.Sensor>,
        <bblocks://ogc.api.sta.Thing>,
        <bblocks://ogc.api.sta.Thing.Properties> ;
    skos:prefLabel "Building Blocks - Sensor Things API Building Blocks" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://british-oceanographic-data-centre.github.io/bblocks-sta/build/bblocks.jsonld> ],
        [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://british-oceanographic-data-centre.github.io/bblocks-sta/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://british-oceanographic-data-centre.github.io/bblocks-sta/build/bblocks.ttl> ] ;
    foaf:homepage <https://british-oceanographic-data-centre.github.io/bblocks-sta/> ;
    bblocks:hasValidationReport <https://british-oceanographic-data-centre.github.io/bblocks-sta/build/tests/report.html> .

