{
  "@context": {
    "name": "dct:title",
    "description": "dct:description",
    "observationType": {
      "@id": "http://www.w3.org/ns/sosa/Observation",
      "@type": "@id"
    },
    "unitOfMeasurement": {
      "@id": "qudt:unit",
      "@context": {
        "name": "sdo:name",
        "symbol": "sdo:symbol",
        "definition": "@id"
      }
    },
    "observedArea": "geo:hasGeometry",
    "phenomenonTime": "http://www.w3.org/ns/sosa/phenomenonTime",
    "resultTime": "http://www.w3.org/ns/sosa/resultTime",
    "ObservedProperty@iot.navigationLink": {
      "@id": "http://www.w3.org/ns/sosa/observedProperty",
      "@type": "@id"
    },
    "Sensor@iot.navigationLink": {
      "@id": "http://www.w3.org/ns/sosa/madeBySensor",
      "@type": "@id"
    },
    "Thing@iot.navigationLink": {
      "@id": "sosa-oms:madeOnPlatform",
      "@type": "@id"
    },
    "@iot.id": "@id",
    "@iot.selfLink": "orel:iana/1.0/self",
    "Observations@iot.navigationLink": {
      "@id": "http://www.w3.org/ns/sosa/hasMember",
      "@type": "@id"
    },
    "dct": "http://purl.org/dc/terms/",
    "qudt": "http://qudt.org/schema/qudt/",
    "sdo": "https://schema.org/",
    "geo": "http://www.opengis.net/ont/geosparql#",
    "sosa-oms": "http://www.w3.org/ns/sosa/oms/",
    "orel": "http://www.opengis.net/def/rel/",
    "@version": 1.1
  }
}