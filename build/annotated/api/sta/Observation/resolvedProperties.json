{"defs":{},"properties":[{"path":["@iot.id"],"id":"@id","description":"The Id of the observation","schema_type":["string","number"],"sources":["bblocks://ogc.api.sta.Observation"],"effectiveId":"@id"},{"path":["@iot.selfLink"],"id":"http://www.opengis.net/def/rel/iana/1.0/self","description":"The direct link to the entity","schema_type":"string","sources":["bblocks://ogc.api.sta.Observation"],"effectiveId":"http://www.opengis.net/def/rel/iana/1.0/self"},{"path":["parameters"],"schema_type":"object","sources":["bblocks://ogc.api.sta.Observation"]},{"path":["phenomenonTime"],"id":"http://www.w3.org/ns/sosa/phenomenonTime","description":"The time when the observation happened. or Time Interval string (e.g., 2010-12-23T10:20:00.00-07:00 or 2010-12-23T10:20:00.00-07:00/2010-12-23T12:20:00.00-07:00)","schema_type":"string","sources":["bblocks://ogc.api.sta.Observation"],"effectiveId":"http://www.w3.org/ns/sosa/phenomenonTime"},{"path":["result"],"id":"http://www.w3.org/ns/sosa/hasSimpleResult","description":"The estimated value of the observed property. Type depends on the observationType defined in the associated Datastream","sources":["bblocks://ogc.api.sta.Observation"],"effectiveId":"http://www.w3.org/ns/sosa/hasSimpleResult"},{"path":["resultQuality"],"id":"http://www.w3.org/ns/dqv#hasQualityMeasurement","description":"A description of the quality of the result. Type DQ_Element.","schema_type":"string","sources":["bblocks://ogc.api.sta.Observation"],"effectiveId":"http://www.w3.org/ns/dqv#hasQualityMeasurement"},{"path":["resultTime"],"id":"http://www.w3.org/ns/sosa/resultTime","description":"The time the result was generated. TM_Instant (ISO 8601 Time string)","schema_type":"string","sources":["bblocks://ogc.api.sta.Observation"],"effectiveId":"http://www.w3.org/ns/sosa/resultTime"},{"path":["validTime"],"description":"The time period during which the result can be used. TM_Period (ISO 8601 Time Interval string)","schema_type":"string","sources":["bblocks://ogc.api.